APP_NAME="BeautyPro Supply"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beautypro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Shop ----
SHOP_NAME="BeautyPro Supply"
SHOP_SHIPPING_FEE=5000
SHOP_FREE_SHIPPING=300000

# ---- QPay (https://developer.qpay.mn) ----
# Set QPAY_MOCK=false and fill the merchant credentials to use the live gateway.
QPAY_MOCK=true
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL="${APP_URL}/api/payments/qpay/callback"
QPAY_INVOICE_TTL=30

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# ---- verify.mn (Mobile-Originated SMS phone verification, https://verify.mn) ----
# API key from your verify.mn dashboard. Required in production; never commit it.
VERIFY_MN_API_KEY=
VERIFY_MN_BASE_URL=https://api.verify.mn
# Public https URL verify.mn GETs when the SMS arrives (wake-up only). Leave empty to poll only.
# Must be reachable — do not register a placeholder URL. Example: https://yourdomain.mn/api/verify/callback
VERIFY_MN_CALLBACK_URL=
# Optional reply SMS (<=160 ASCII chars). Unitel sends only the default reply, Lime sends none.
VERIFY_MN_RESPONSE_SMS=
# Development only: simulate verify.mn locally when no API key is set.
VERIFY_MOCK=false
VERIFY_REQUIRE_FOR_CHECKOUT=true
